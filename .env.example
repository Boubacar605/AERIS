# =============================================================
# AERIS — Configuration
# Architecture Edge-cloud pour la Radiologie Intelligente au Senegal
# =============================================================

# --- General ---
NOM_PROJET=aeris
ENVIRONNEMENT=developpement

# --- Service Tuberculose ---
SERVICE_TB_HOTE=0.0.0.0
SERVICE_TB_PORT=8001
SERVICE_TB_CHEMIN_MODELE_EDGE=./modeles_entraines/modele_tuberculose.h5
SERVICE_TB_CHEMIN_MODELE_CLOUD=./modeles_entraines/modele_tuberculose_cloud.h5

# --- Service Pneumonie ---
SERVICE_PN_HOTE=0.0.0.0
SERVICE_PN_PORT=8002
SERVICE_PN_CHEMIN_MODELE_EDGE=./modeles_entraines/modele_pneumonie.h5
SERVICE_PN_CHEMIN_MODELE_CLOUD=./modeles_entraines/modele_pneumonie_cloud.h5

# --- Moteur de Decision ---
MOTEUR_DECISION_HOTE=0.0.0.0
MOTEUR_DECISION_PORT=8003

# Seuils de decision
SEUIL_CPU=80
SEUIL_RAM=85
SEUIL_LATENCE_MS=100

# URLs des services (pour le moteur de decision)
URL_SERVICE_TB_EDGE=http://service-tuberculose-edge:8001
URL_SERVICE_TB_CLOUD=http://service-tuberculose-cloud:8001
URL_SERVICE_PN_EDGE=http://service-pneumonie-edge:8002
URL_SERVICE_PN_CLOUD=http://service-pneumonie-cloud:8002

# --- Monitoring ---
PROMETHEUS_PORT=9090

# --- Limites de ressources Edge (simulation) ---
EDGE_LIMITE_CPU=1.0
EDGE_LIMITE_MEMOIRE=512m

# --- Tableau de Bord ---
TABLEAU_DE_BORD_PORT=3000
VITE_URL_API=http://localhost:8003
# URL publique du tableau de bord (lien OTP contenu dans les emails) :
# ex. sous tunnel : TABLEAU_DE_BORD_PUBLIQUE=https://mon-tunnel.ts.net
TABLEAU_DE_BORD_PUBLIQUE=http://localhost:3000

# --- Authentification RBAC & notifications OTP ---
JWT_SECRET=aeris-dev-secret-a-changer
JWT_TTL_ACCES_MINUTES=30
OTP_TTL_MINUTES=15
ADMIN_INITIAL_EMAIL=admin@aeris.local
ADMIN_INITIAL_MOT_DE_PASSE=Admin@aeris2026
# Compte clinicien initial : seul role autorise sur /routage/analyser et
# /routage/patient (le role admin est purement IT). Sans lui, aucune
# radiographie ne peut etre analysee apres un demarrage vierge.
CLINICIEN_INITIAL_EMAIL=clinicien@aeris.local
CLINICIEN_INITIAL_MOT_DE_PASSE=Clinicien@aeris2026

# --- MailHog (SMTP de developpement) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- SMTP (Gmail direct en prod, MailHog si vide) ---
# Gmail : SMTP_HOTE=smtp.gmail.com, SMTP_PORT=587, compte + mot de passe
# d'application (2-Step Verification activée). Brevo fonctionne aussi.
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=hello@aeris.sn     # Email du compte (Gmail ou Brevo)
SMTP_MOT_DE_PASSE=                  # Mot de passe d'application Gmail / clé SMTP Brevo
SMTP_EXPEDITEUR=hello@aeris.sn      # Adresse expéditeur (visible par le patient)

# --- WhatsApp via le relais AERIS (Baileys) — vide = OTP simulé dans les logs ---
# Relais Node.js (services/relay-whatsapp) relié au numéro émetteur par QR au
# premier démarrage ; envoie des messages libres en français (pas de template).
WHATSAPP_URL_RELAY=http://relay-whatsapp:3500
WHATSAPP_RELAY_SECRET=aeris-dev-secret-whatsapp
WHATSAPP_PREFIXE_PAYS=221          # Préfixe appliqué aux numéros OTP (Sénégal)

# URL publique du tableau de bord (liens OTP dans les emails envoyés aux patients)
TABLEAU_DE_BORD_PUBLIQUE=http://localhost:3000
