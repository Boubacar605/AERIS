    "from pathlib import Path\n",
    "for base in ['/kaggle/input', '/kaggle/input/datasets']:\n",
    "    p=Path(base)\n",
    "    print('=====', base, 'existe', p.exists())\n",
    "    if not p.exists(): continue\n",
    "    for q in sorted(p.iterdir()):\n",
    "        print('   ', q.name, 'dir' if q.is_dir() else 'fichier')\n"
  ]}
